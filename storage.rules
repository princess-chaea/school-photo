rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 운영자가 올리는 디자인 전용. 참가자는 로그인/업로드를 하지 않습니다.
    // 게시 행사에는 다운로드 토큰 URL이 들어갑니다. 행사 디자인은 공개 자료입니다.
    match /users/{uid}/assets/{assetId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if owner();
      allow create: if owner()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if owner();
      allow update: if false;
    }
    match /shared/assets/{assetId} {
      function admin() { return request.auth != null && request.auth.token.email == 'dltjdrms320@gmail.com' && request.auth.token.email_verified == true; }
      allow read: if true;
      allow create: if admin() && request.resource.size < 4 * 1024 * 1024 && request.resource.contentType == 'image/webp';
      allow update: if false;
      allow delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
