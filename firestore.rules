rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function siteAdmin() { return signedIn() && request.auth.token.email == 'dltjdrms320@gmail.com' && request.auth.token.email_verified == true; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function validPhotoRect(s) { return s is map && s.keys().hasOnly(['x','y','w','h']) && s.x is number && s.y is number && s.w is number && s.h is number && s.x >= 0 && s.y >= 0 && s.w >= 0.025 && s.h >= 0.025 && s.x+s.w <= 1.000001 && s.y+s.h <= 1.000001; }
    function validFrameMode(d) { return (!('preserveAspect' in d) || (d.kind == 'frame' && d.preserveAspect is bool)) && (!('clearPhotoSlots' in d) || (d.kind == 'frame' && d.clearPhotoSlots is bool)) && (!('layoutCount' in d) || d.layoutCount != 0 || ('preserveAspect' in d && d.preserveAspect == true)); }
    function validPhotoSlots(d) { return !('photoSlots' in d) || (d.kind == 'frame' && d.photoSlots is list && d.photoSlots.size() == d.layoutCount && d.photoSlots.size() in [2,4,6,8] && (d.photoSlots.size() <= 0 || validPhotoRect(d.photoSlots[0])) && (d.photoSlots.size() <= 1 || validPhotoRect(d.photoSlots[1])) && (d.photoSlots.size() <= 2 || validPhotoRect(d.photoSlots[2])) && (d.photoSlots.size() <= 3 || validPhotoRect(d.photoSlots[3])) && (d.photoSlots.size() <= 4 || validPhotoRect(d.photoSlots[4])) && (d.photoSlots.size() <= 5 || validPhotoRect(d.photoSlots[5])) && (d.photoSlots.size() <= 6 || validPhotoRect(d.photoSlots[6])) && (d.photoSlots.size() <= 7 || validPhotoRect(d.photoSlots[7]))); }
    function validBrandPart(p, min, max, allowed) {
      let colors=p.get('letterColors',[]);
      let fonts=p.get('letterFonts',[]);
      return p.keys().hasOnly(allowed)
        && p.visible is bool && p.position.matches('(top|bottom|free)')
        && p.x >= 0 && p.x <= 1 && p.y >= 0 && p.y <= 1
        && p.size >= min && p.size <= max
        && p.color.matches('(|#[0-9a-fA-F]{6})')
        && p.get('font','baeum').matches('(baeum|night|round|edge|poster|marker|keris-[a-z0-9-]{1,100})')
        && p.get('anchor','').matches('(|top|bottom)')
        && p.get('styledText','').size() <= 100
        && colors.size() <= 100
        && colors.join('|').matches('(#[0-9a-fA-F]{6})?(\\|(#[0-9a-fA-F]{6})?)*')
        && p.get('letterSizes',[]).size() <= 100
        && fonts is list && fonts.size() <= 100
        && fonts.join('|').matches('(baeum|night|round|edge|poster|marker|keris-[a-z0-9-]{1,100})?(\\|(baeum|night|round|edge|poster|marker|keris-[a-z0-9-]{1,100})?)*');
    }
    // As with frame/sticker lists, each text box is normalized before rendering.
    function validExtraTexts(texts) { return texts is list && texts.size() <= 8; }
    function validBranding(b) {
      let allowed=['visible','position','x','y','size','color','font','anchor','styledText','letterColors','letterSizes','letterFonts'];
      return b is map && b.keys().hasOnly(['height','captureDate','logo','school','title','schedule','texts'])
        && validExtraTexts(b.get('texts',[]))
        && b.height is number && b.height >= 0.08 && b.height <= 0.60 && b.captureDate is bool
        && validBrandPart(b.logo,0.035,0.35,allowed) && validBrandPart(b.school,0.012,0.10,allowed)
        && validBrandPart(b.title,0.012,0.10,allowed) && validBrandPart(b.schedule,0.012,0.10,allowed);
    }
    function validSharing(s) {
      return s is map && s.keys().hasAll(['mode','url','relayUrl','boardId','submissionKey'])
        && s.keys().hasOnly(['mode','url','relayUrl','boardId','submissionKey'])
        && s.mode in ['none','link','drive','padlet']
        && s.url is string && s.url.size() <= 2048 && (s.url == '' || s.url.matches('https://[^ @]+'))
        && s.relayUrl is string && (s.relayUrl == '' || s.relayUrl.matches('https://script[.]google[.]com/macros/s/[a-zA-Z0-9_-]+/exec'))
        && s.boardId is string && s.boardId.size() <= 100 && (s.boardId == '' || s.boardId.matches('[a-zA-Z0-9_-]+'))
        && s.submissionKey is string && s.submissionKey.size() <= 100 && (s.submissionKey == '' || s.submissionKey.matches('[a-zA-Z0-9_-]{20,100}'));
    }
    function validEvent(d) {
      return d.keys().hasOnly(['ownerId', 'published', 'title', 'school', 'schedule', 'logo', 'logoPosition', 'frames', 'stickers', 'updatedAt', 'branding', 'orientation', 'sharing'])
        && (!('branding' in d) || validBranding(d.branding))
        && (!('sharing' in d) || validSharing(d.sharing))
        && d.ownerId is string && d.published is bool
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.school is string && d.school.size() <= 60
        && d.schedule is string && d.schedule.size() <= 100
        && d.logo is string && d.logo.size() <= 4096
        && (!('frameFormat' in d) || d.frameFormat in ['print-4x6','print-3x5','print-5x7','square','feed','story','a4','screen'])
            && (!('orientation' in d) || d.orientation in ['portrait','landscape'])
        && d.logoPosition in ['top', 'bottom']
        && d.frames is list && d.frames.size() > 0 && d.frames.size() <= 32
        && d.stickers is list && d.stickers.size() <= 256
        && d.updatedAt == request.time;
    }
    function mayPublish(data) {
      return data.published == false || !exists(/databases/$(database)/documents/userDirectory/$(request.auth.uid)) || !('publishingBlocked' in get(/databases/$(database)/documents/userDirectory/$(request.auth.uid)).data) || get(/databases/$(database)/documents/userDirectory/$(request.auth.uid)).data.publishingBlocked != true;
    }
    function validDirectoryDates(d) {
      return (!('createdAt' in d) || (d.createdAt is timestamp && d.createdAt <= request.time))
        && (!('firstSeen' in d) || (d.firstSeen is timestamp && d.firstSeen <= request.time));
    }
    match /userDirectory/{uid} {
      allow get: if siteAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if siteAdmin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['displayName','email','lastSeen','createdAt','firstSeen']) && validDirectory(request.resource.data) && validDirectoryDates(request.resource.data) && (!('firstSeen' in request.resource.data) || request.resource.data.firstSeen == request.time);
      allow update: if (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','email','lastSeen','createdAt','firstSeen']) && validDirectory(request.resource.data) && validDirectoryDates(request.resource.data)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (('firstSeen' in resource.data) ? request.resource.data.firstSeen == resource.data.firstSeen : (!('firstSeen' in request.resource.data) || request.resource.data.firstSeen == request.time)))
        || (siteAdmin() && request.auth.uid != uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publishingBlocked']) && request.resource.data.publishingBlocked is bool);
    }
    function validDirectory(d) { return d.displayName is string && d.displayName.size() <= 80 && d.email == request.auth.token.email && d.lastSeen == request.time; }
    match /events/{eventId} {
      // 참가자는 QR에 적힌 게시 행사 한 건만 읽습니다. 전체 공개 목록은 허용하지 않습니다.
      allow get: if siteAdmin() || resource.data.published == true || owns(resource.data);
      allow list: if siteAdmin() || owns(resource.data);
      allow create: if owns(request.resource.data) && validEvent(request.resource.data) && mayPublish(request.resource.data);
      allow update: if (owns(resource.data) && request.resource.data.ownerId == resource.data.ownerId && validEvent(request.resource.data) && mayPublish(request.resource.data)) || (siteAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published','updatedAt']) && request.resource.data.published == false && request.resource.data.updatedAt == request.time);
      allow delete: if owns(resource.data);
    }
    function usageTotal(d) { return d.visits + d.starts + d.cameraShots + d.photoImports + d.completions + d.downloads + d.shares + d.submissions; }
    match /usageDaily/{usageId} {
      function validUsage(d) {
        return d.keys().hasOnly(['eventId','shard','day','updatedAt','visits','starts','cameraShots','photoImports','completions','downloads','shares','submissions'])
          && d.eventId is string && d.eventId.matches('[a-zA-Z0-9_-]{1,100}')
          && d.day is timestamp && d.day == (request.time + duration.value(9,'h')).date() - duration.value(9,'h')
          && d.shard is int && d.shard >= 0 && d.shard < 8 && usageId == d.eventId + '_' + string(int(d.day.toMillis())) + '_' + string(d.shard) && d.updatedAt == request.time
          && d.visits is int && d.visits >= 0
          && d.starts is int && d.starts >= 0
          && d.cameraShots is int && d.cameraShots >= 0
          && d.photoImports is int && d.photoImports >= 0
          && d.completions is int && d.completions >= 0
          && d.downloads is int && d.downloads >= 0
          && d.shares is int && d.shares >= 0
          && d.submissions is int && d.submissions >= 0
          && get(/databases/$(database)/documents/events/$(d.eventId)).data.published == true;
      }
      allow read: if siteAdmin();
      allow create: if validUsage(request.resource.data) && usageTotal(request.resource.data) == 1;
      allow update: if validUsage(request.resource.data) && request.resource.data.eventId == resource.data.eventId && request.resource.data.day == resource.data.day && request.resource.data.shard == resource.data.shard
        && request.resource.data.visits >= resource.data.visits
        && request.resource.data.starts >= resource.data.starts
        && request.resource.data.cameraShots >= resource.data.cameraShots
        && request.resource.data.photoImports >= resource.data.photoImports
        && request.resource.data.completions >= resource.data.completions
        && request.resource.data.downloads >= resource.data.downloads
        && request.resource.data.shares >= resource.data.shares
        && request.resource.data.submissions >= resource.data.submissions
        && usageTotal(request.resource.data) == usageTotal(resource.data) + 1;
      allow delete: if false;
    }
    match /moderationActions/{actionId} {
      allow read: if siteAdmin();
      allow create: if siteAdmin() && request.resource.data.keys().hasOnly(['eventId','eventTitle','actorId','action','reason','createdAt'])
        && request.resource.data.eventId is string && request.resource.data.eventId.matches('[a-zA-Z0-9_-]{1,100}')
        && request.resource.data.eventTitle is string && request.resource.data.eventTitle.size() <= 80
        && request.resource.data.actorId == request.auth.uid && request.resource.data.action == 'unpublish'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300 && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.published == true
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.published == false
        && request.resource.data.eventTitle == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.title;
      allow update, delete: if false;
    }
    match /users/{uid}/assets/{assetId} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      function validAsset(d) {
        return validPhotoSlots(d) && validFrameMode(d) && d.keys().hasAll(['name', 'kind']) && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && ((d.kind == 'palette' && d.keys().hasOnly(['name', 'kind', 'bg', 'ink'])
            && d.bg is string && d.bg.matches('#[0-9a-fA-F]{6}') && d.ink is string && d.ink.matches('#[0-9a-fA-F]{6}'))
          || (d.kind in ['logo', 'frame', 'sticker'] && d.keys().hasOnly(['name', 'kind', 'url', 'path', 'originalBytes', 'optimizedBytes', 'width', 'height', 'format', 'layoutCount', 'orientation', 'photoSlots','frameFormat','preserveAspect','clearPhotoSlots'])
            && (!('frameFormat' in d) || d.frameFormat in ['print-4x6','print-3x5','print-5x7','square','feed','story','a4','screen'])
            && (!('orientation' in d) || d.orientation in ['portrait','landscape'])
            && (!('layoutCount' in d) || (d.kind == 'frame' && d.layoutCount in [0,2,4,6,8]))
            && d.url is string && d.url.size() <= 4096 && d.path is string && d.path == 'users/' + uid + '/assets/' + assetId));
      }
      allow read: if owner();
      allow create: if owner() && validAsset(request.resource.data);
      allow delete: if owner();
      allow update: if false;
    }
    match /users/{uid}/profile/school {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['school', 'logo', 'updatedAt'])
        && request.resource.data.school is string && request.resource.data.school.size() <= 60
        && request.resource.data.logo is string && request.resource.data.logo.size() <= 4096
        && request.resource.data.updatedAt == request.time;
    }
    match /sharedAssets/{assetId} {
      function validShared(d) {
        return (d.keys().hasOnly(['name','kind','bg','ink','active']) && d.kind == 'palette' && d.name is string && d.name.size() > 0 && d.name.size() <= 60 && d.bg.matches('#[0-9a-fA-F]{6}') && d.ink.matches('#[0-9a-fA-F]{6}') && d.active is bool) || (validPhotoSlots(d) && validFrameMode(d) && d.keys().hasAll(['name','kind','url','path','active'])
          && d.keys().hasOnly(['name','kind','url','path','active','originalBytes','optimizedBytes','width','height','format','layoutCount','orientation','photoSlots','frameFormat','preserveAspect','clearPhotoSlots'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && (!('frameFormat' in d) || d.frameFormat in ['print-4x6','print-3x5','print-5x7','square','feed','story','a4','screen'])
          && d.kind in ['frame','sticker'] && d.url is string && d.url.size() <= 4096
          && d.path == 'shared/assets/' + assetId && d.active is bool
          && (d.kind != 'frame' || (d.layoutCount in [0,2,4,6,8])));
      }
      allow read: if true;
      allow create: if siteAdmin() && validShared(request.resource.data);
      allow update: if siteAdmin() && validShared(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }
    // 참가자 사진이나 완성 이미지를 저장하는 컬렉션은 없습니다.
    match /{document=**} { allow read, write: if false; }
  }
}
