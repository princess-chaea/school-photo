# Firebase Console > 프로젝트 설정 > 일반 > 웹 앱 > SDK 설정
# Firebase web config는 공개 설정입니다. 데이터 보호는 firestore.rules / storage.rules가 담당합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 학생 전용 Hosting 주소. 미설정 시 아래 기본 주소를 사용합니다.
VITE_STUDENT_BASE_URL=https://teacher-student-photo-students.web.app/
